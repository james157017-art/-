/**
 * 전체 자동화 실행
 */
function autoEvaluationSystem() {
  var ui = SpreadsheetApp.getUi();
  
  // 확인 메시지
  var response = ui.alert(
    '평가 시스템 자동화',
    '평가 폼 생성 및 이메일 발송을 시작하시겠습니까?\n\n' +
    '1. 고도화된 평가 폼 생성\n' +
    '2. HTML 이메일 자동 발송\n\n' +
    '※ 이메일 발송 제한: 하루 100통 (무료 계정)',
    ui.ButtonSet.YES_NO
  );
  
  if (response == ui.Button.YES) {
    // 1단계: 평가 폼 생성
    ui.alert('1단계: 평가 폼을 생성하고 있습니다...');
    var formUrl = createAdvancedEvaluationForm();
    
    // 2단계: 이메일 발송
    ui.alert('2단계: 이메일을 발송하고 있습니다...\n잠시만 기다려주세요.');
    Utilities.sleep(2000);
    sendBeautifulEmails();
    
    ui.alert('✅ 모든 작업이 완료되었습니다!\n\n평가 폼: ' + formUrl);
  }
}

