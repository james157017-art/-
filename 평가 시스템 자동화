/**
 * HTML 형식의 예쁜 이메일 자동 발송
 */
function sendBeautifulEmails() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var data = sheet.getDataRange().getValues();
  var formUrl = sheet.getRange('H2').getValue();
  
  // 폼 URL이 없으면 종료
  if (!formUrl) {
    SpreadsheetApp.getUi().alert('먼저 평가 폼을 생성해주세요!');
    return;
  }
  
  var successCount = 0;
  var failCount = 0;
  
  // 2번째 행부터 데이터 처리 (1번째 행은 헤더)
  for (var i = 1; i < data.length; i++) {
    var name = data[i][0];          // A열: 이름
    var email = data[i][1];         // B열: 이메일
    var department = data[i][2];    // C열: 부서
    var position = data[i][3];      // D열: 직급
    var evalType = data[i][4];      // E열: 평가유형
    var sendStatus = data[i][5];    // F열: 발송상태
    
    // 이미 발송완료된 경우 건너뛰기
    if (sendStatus === '발송완료') {
      continue;
    }
    
    // 빈 이메일은 건너뛰기
    if (!email || email.trim() === '') {
      sheet.getRange(i + 1, 6).setValue('이메일 없음');
      continue;
    }
    
    try {
      // 이메일 제목
      var subject = '🔔 [' + evalType + '] 2025년 상반기 직원 역량 평가 참여 안내';
      
      // HTML 이메일 본문
      var htmlBody = createEmailTemplate(name, department, position, evalType, formUrl);
      
      // 이메일 발송
      MailApp.sendEmail({
        to: email,
        subject: subject,
        htmlBody: htmlBody
      });
      
      // 발송 완료 표시
      sheet.getRange(i + 1, 6).setValue('발송완료');
      sheet.getRange(i + 1, 6).setBackground('#d9ead3');
      successCount++;
      
      // 서버 부하 방지 (0.5초 대기)
      Utilities.sleep(500);
      
    } catch (e) {
      // 에러 발생 시
      sheet.getRange(i + 1, 6).setValue('발송실패');
      sheet.getRange(i + 1, 6).setBackground('#f4cccc');
      sheet.getRange(i + 1, 6).setNote(e.message);
      failCount++;
    }
  }
  
  // 완료 메시지
  var message = '이메일 발송 완료!\n\n' +
                '✅ 성공: ' + successCount + '건\n' +
                '❌ 실패: ' + failCount + '건';
  SpreadsheetApp.getUi().alert(message);
}

